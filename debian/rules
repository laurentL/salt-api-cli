#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk

export DH_VERBOSE = 1

LDFLAGS := -X github.com/laurentL/salt-api-cli/internal/cli.Version=$(DEB_VERSION_UPSTREAM)

%:
	dh $@ --builddirectory=_build --buildsystem=golang

override_dh_auto_build:
	dh_auto_build -- -ldflags "$(LDFLAGS)"
	_build/bin/sapi man --dir man
	mkdir -p _build/completions
	_build/bin/sapi completion bash > _build/completions/sapi.bash
	_build/bin/sapi completion zsh > _build/completions/_sapi
	_build/bin/sapi completion fish > _build/completions/sapi.fish

override_dh_auto_install:
	dh_auto_install -- --no-source
	install -D -m 0644 _build/completions/sapi.bash $(CURDIR)/debian/sapi/usr/share/bash-completion/completions/sapi
	install -D -m 0644 _build/completions/_sapi $(CURDIR)/debian/sapi/usr/share/zsh/vendor-completions/_sapi
	install -D -m 0644 _build/completions/sapi.fish $(CURDIR)/debian/sapi/usr/share/fish/vendor_completions.d/sapi.fish

override_dh_dwz:
	# Skip dwz on Go binaries
